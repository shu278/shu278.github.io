#header
  height: banner-height
  position: relative
  &:before, &:after
    content: ""
    position: absolute
    left: 0
    right: 0
    pointer-events: none
  &:before
    top: 0
    height: 100%
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.34) 0%, rgba(0, 0, 0, 0.12) 38%, rgba(0, 0, 0, 0.10) 62%, rgba(0, 0, 0, 0.26) 100%)
  &:after
    bottom: 0
    height: 120px
    background: linear-gradient(to bottom, rgba(244, 243, 240, 0) 0%, rgba(244, 243, 240, 0.75) 100%)

#header-outer
  height: 100%
  position: relative

#header-inner
  position: relative
  overflow: hidden

#banner
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  background: url(banner-url) center 30% #000
  background-size: cover
  background-position: center 30%
  z-index: -1

#header-title
  text-align: center
  height: logo-size
  position: absolute
  top: 50%
  left: 0
  margin-top: logo-size * -0.5

$logo-text
  text-decoration: none
  color: #fff
  font-weight: 700
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55), 0 2px 12px rgba(0, 0, 0, 0.35)

#logo
  @extend $logo-text
  font-size: logo-size
  line-height: logo-size
  letter-spacing: 2px

#subtitle
  @extend $logo-text
  font-size: subtitle-size
  line-height: subtitle-size
  letter-spacing: 1px
  font-weight: 400
  opacity: 0.92

#subtitle-wrap
  margin-top: subtitle-size

#main-nav
  float: left
  margin-left: -15px

$nav-link
  float: left
  color: #f7f6f3
  font-size: 16px
  font-weight: 600
  text-decoration: none
  background: rgba(0, 0, 0, 0.22)
  border-radius: 5px
  margin: 13px 5px
  padding: 9px 16px
  display: block
  border-bottom: 2px solid transparent
  transition: background 0.2s, color 0.2s, border-color 0.2s
  &:hover
    color: #fff
    background: rgba(0, 0, 0, 0.38)
  &.active
    color: #fff
    background: rgba(0, 0, 0, 0.30)
    font-weight: 700
    border-bottom-color: rgba(255, 255, 255, 0.9)

.nav-icon
  @extend $nav-link
  text-align: center
  font-size: 14px
  width: 34px
  height: 34px
  line-height: 34px
  padding: 0
  margin: 13px 3px
  border-radius: 50%
  position: relative
  cursor: pointer

.main-nav-link
  @extend $nav-link
  font-weight: 600
  letter-spacing: 1px
  @media mq-mobile
    display: none

#main-nav-toggle
  display: none
  @media mq-mobile
    display: block

#sub-nav
  float: right
  margin-right: -15px

#search-form-wrap
  position: absolute
  top: 15px
  width: 150px
  height: 30px
  right: -150px
  opacity: 0
  transition: 0.2s ease-out
  &.on
    opacity: 1
    right: 0
  @media mq-mobile
    width: 100%
    right: -100%

.search-form
  position: absolute
  top: 0
  left: 0
  right: 0
  background: #fff
  padding: 5px 15px
  border-radius: 15px
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.3)

.search-form-input
  border: none
  background: none
  color: color-default
  width: 100%
  font: 13px font-sans
  outline: none
  &::-webkit-search-results-decoration
  &::-webkit-search-cancel-button
    -webkit-appearance: none

.search-form-submit
  position: absolute
  top: 50%
  right: 10px
  margin-top: -7px
  font: 13px font-icon
  border: none
  background: none
  color: #bbb
  cursor: pointer
  &:hover, &:focus
    color: #777